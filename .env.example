# Copia este archivo como ".env" y rellena tus datos:
#     cp .env.example .env
# El archivo ".env" está en .gitignore: no se sube al repositorio.

# --- Credenciales del correo (obligatorio para enviar) ---
SMTP_USER=tu_correo@gmail.com
# Con Gmail NO uses tu contraseña normal: crea una "contraseña de aplicación"
# (ver README). Se puede escribir con o sin espacios.
SMTP_PASSWORD=

# --- Servidor (opcional; por defecto Gmail) ---
# El puerto 465 usa SSL; el 587 usa STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- Personalización (opcional) ---
SENDER_NAME=Amigo Invisible
EMAIL_SUBJECT=Tu asignación del Amigo Invisible
EVENT_BUDGET=20 € – 30 €
EVENT_DATE=Nochebuena
# EVENT_YEAR=2026   # por defecto, el año actual
